  "facts": [
    {
      "fact_id": "world_directed_axis_angle",
      "source_ids": ["blender_exact_build_overhang"],
      "statement": "計算以 polygon / BMesh face 法線和所選有向軸的夾角進行。object_to_world 的轉置把世界方向轉回局部再正規化；對 Scale 1 的剛性旋轉，等效於世界法線與世界有向軸比較，不要求先 Apply Rotation。",
      "project_axis": "NEG_Z",
      "project_angle_definition": "面外法線與世界負 Z 軸夾角：水平朝下 0°、垂直面 90°、水平朝上 180°。",
      "scope": "僅針對本課 Scale 1／無變形 modifier 的剛體情境；不擴張為任意非均勻縮放結論。"
    },
    {
      "fact_id": "native_min_max_remap",
      "source_ids": ["blender_exact_build_overhang", "blender_exact_build_analysis_shader", "blender_exact_build_statvis_rna"],
      "statement": "RNA 角度存 radians，介面顯示角度。顯示 Min/Max 可在 0～180°範圍設定，本課選名義 0～45°；保留每次實際 float radians 及換算 degrees。",
      "scalar_remap": {
        "angle_below_minimum": 1,
        "angle_between_minimum_and_maximum": "1 - (angle - minimum) / (maximum - minimum)",
        "angle_above_maximum": -1,
        "minimum_boundary": 1,
        "maximum_boundary": 0
      },
      "color_scope": "負權重在 shader 中顯示灰色；範圍內從 weight texture 取色。出廠一般色帶的高權重端為紅、低端為藍，實際顏色以本次原生截圖為證。低於 Min 是高端飽和，不是灰色。",
      "range_role": "顯示範圍，不是材料、機型、橋接或支撐的合格角度。",
      "numeric_boundary_band_deg": 0.0001,
      "numeric_boundary_note": "邊界帶只標示浮點敏感面；不擴張顯示門檻，不把 Python double 分類當 GPU 像素讀值。"
    },
    {
      "fact_id": "native_faces_and_derived_facets",
      "source_ids": ["blender_exact_build_overhang"],
      "statement": "原生 shader 分類按 polygon / BMFace normal；loop triangle 數不等於原生面數。本專案保留 polygon rings、triangle-to-polygon indices 及實際世界法線，另算 polygon 與 loop-triangle 角度、面積及數量並分欄。",
      "scope": "另算統計不是原生面板提供的面數，也不是 GPU framebuffer 的直接讀值；非共面多邊形不能默認與其三角面角度相同。"
    },
    {
      "fact_id": "edit_overlay_context",
      "source_ids": ["installed_blender_analysis_ui", "blender_official_manual_background"],
      "statement": "Mesh Edit Mode overlay 提供 Mesh Analysis、OVERHANG、Minimum、Maximum 及有向 Axis；本課保留 Solid shading、關閉 X-Ray 並讀回 overlay 開關。"
    },
    {
      "fact_id": "project_bed_and_support_distinction",
      "source_ids": ["blender_exact_build_overhang"],
      "statement": "原生角度計算本身沒有床面接觸、支撐生成、橋接跨度或前層承托判斷。本專案另以世界 Z=0 分開記錄床接觸面與非床接觸的朝下面；局部角度不能單獨決定需要支撐或可列印。",
      "project_interpretation": true,
      "bed_height_epsilon_mm": 0.0001,
      "epsilon_role": "浮點重建／落床讀值核對；不是製造公差、附著品質或實體平台校正證據。"
    }
  ],
