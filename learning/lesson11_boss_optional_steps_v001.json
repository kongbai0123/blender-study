    {
      "id": "11-BOSS-OPT-03",
      "goal": "將圓柱設為 8 mm 外形",
      "context": "仍在 Object Mode，Cylinder 已選取，且上一個 2000 mm 的前提已確認。",
      "operation": [
        "在 3D View 依序按 S、輸入 0.004、Enter。",
        "按 F3，搜尋 Apply Scale，按 Enter。",
        "依序按 G、Z，輸入 4mm，按 Enter。"
      ],
      "success": "側欄 Dimensions 約 8 × 8 × 8 mm，Scale 為 1、1、1，Location Z 為 4 mm。",
      "readings": [
        {
          "location": "3D View 側欄 Item → Transform；數值由 Blender 程式讀回",
          "value": "Dimensions 約 8.000015 × 8.000015 × 8.000015 mm；Scale 1、1、1；Location Z 4 mm",
          "source": "safe-summary.records[2].observed"
        }
      ],
      "limits": [
        "畫面常將小數四捨五入為 8 mm；此為數位草案尺寸。"
      ],
      "screenshot": {
        "relativePath": "learning/evidence/08/2026-10-28-manual-boss-gui-trial-v003/08-BOSS-GUI-03-scaled.png",
