  "reference_box_summary": "沿用原 04 盒體：外形 60 × 40 × 30、內腔 56 × 36 × 28、壁與底 2 mm。另建只有原盒的卡扣參考場景，尚未建立卡扣臂；盒壁 2 mm 不是臂厚 h。",
  "parameters": [
    {
      "id": "arm_length",
      "symbol": "L",
      "label": "有效臂長",
      "definition": "從固定根部至實際負載／接觸點；先選定卡扣位置及彎曲方向。",
      "value": null,
      "unit": "mm"
    },
    {
      "id": "arm_thickness",
      "symbol": "h",
      "label": "臂根厚度",
      "definition": "彎曲方向的厚度；均勻矩形估算假設沿長度不變。不能直接採用原盒壁厚。",
      "value": null,
      "unit": "mm"
    },
    {
      "id": "arm_width",
      "symbol": "b",
      "label": "臂寬",
      "definition": "垂直於彎曲平面的寬度；仍會影響剛度及裝拆力。",
      "value": null,
      "unit": "mm"
    },
    {
      "id": "root_radius",
      "symbol": "R",
      "label": "根部圓角",
      "definition": "根部過渡半徑；需核對應力集中與可製造性。",
      "value": null,
      "unit": "mm"
    },
    {
      "id": "undercut",
      "symbol": "u",
      "label": "倒扣深度",
      "definition": "卡鉤與配合件的幾何倒扣量；不等同材料允許撓度。",
